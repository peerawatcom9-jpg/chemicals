-- สร้างสวิตช์ — เปลี่ยนสีเป็นเขียว
local function CreateSwitch(id, titleText, categoryHeader, callback)
    if categoryHeader then
        local HeaderLabel = Instance.new("TextLabel")
        HeaderLabel.Size = UDim2.new(1, 0, 0, 25)
        HeaderLabel.BackgroundTransparency = 1
        HeaderLabel.Text = categoryHeader
        HeaderLabel.TextColor3 = Color3.fromRGB(150, 255, 150)
        HeaderLabel.Font = Enum.Font.GothamBold
        HeaderLabel.TextSize = 15
        HeaderLabel.TextXAlignment = Enum.TextXAlignment.Left
        HeaderLabel.Parent = ScrollContainer
    end

    local ItemFrame = Instance.new("Frame")
    ItemFrame.Size = UDim2.new(1, -10, 0, 35)
    ItemFrame.BackgroundColor3 = Color3.fromRGB(35, 70, 35)
    ItemFrame.Parent = ScrollContainer
    Instance.new("UICorner", ItemFrame).CornerRadius = UDim.new(0, 6)

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -60, 1, 0)
    Label.Position = UDim2.new(0, 10, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = id .. ". " .. titleText
    Label.TextColor3 = Color3.fromRGB(220, 255, 220)
    Label.Font = Enum.Font.Gotham
    Label.TextSize = 14
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = ItemFrame

    -- สวิตช์ไฟสีเขียว
    local SwitchTrack = Instance.new("TextButton")
    SwitchTrack.Size = UDim2.new(0, 44, 0, 22)
    SwitchTrack.Position = UDim2.new(1, -50, 0.5, -11)
    SwitchTrack.BackgroundColor3 = Color3.fromRGB(50, 80, 50)
    SwitchTrack.Text = ""
    SwitchTrack.Parent = ItemFrame
    Instance.new("UICorner", SwitchTrack).CornerRadius = UDim.new(1, 0)

    local SwitchKnob = Instance.new("Frame")
    SwitchKnob.Size = UDim2.new(0, 18, 0, 18)
    SwitchKnob.Position = UDim2.new(0, 2, 0.5, -9)
    SwitchKnob.BackgroundColor3 = Color3.fromRGB(200, 255, 200)
    SwitchKnob.Parent = SwitchTrack
    Instance.new("UICorner", SwitchKnob).CornerRadius = UDim.new(1, 0)

    local state = false
    SwitchTrack.MouseButton1Click:Connect(function()
        state = not state
        if state then
            TweenService:Create(SwitchTrack, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 200, 90)}):Play()
            TweenService:Create(SwitchKnob, TweenInfo.new(0.2), {Position = UDim2.new(1, -20, 0.5, -9)}):Play()
        else
            TweenService:Create(SwitchTrack, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50, 80, 50)}):Play()
            TweenService:Create(SwitchKnob, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, -9)}):Play()
        end
        pcall(callback, state)
    end)
end

